<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quantum-cli</ToolCommandName>
    <AssemblyName>quantum-cli</AssemblyName>
    <PackageId>Quantum.Platform.Cli</PackageId>
    <Version>0.2.0</Version>
    <Authors>IO7</Authors>
    <Description>Official CLI for unattended Quantum plugin publication.</Description>
    <PackageProjectUrl>https://github.com/io7-cn/Quantum.Cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/io7-cn/Quantum.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>quantum; plugin; cli; dotnet-tool; oidc</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Quantum.Cli.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
